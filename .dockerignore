# Keep secrets, dev data, and build noise out of the image.
# NOTE: .env files must never be baked into a production image.
.env
.env.*
!.env.example

# local dev state
prisma/dev.db
prisma/dev.db-journal
storage/
sample-data/

# git / CI
.git
.github
.gitignore
Dockerfile
docker-compose.yml
render.yaml
README.md
LICENSE

# deps / build output (rebuilt inside the image)
node_modules
.next
tsconfig.tsbuildinfo
*.log

# editors
.vscode
.idea
